   "source": [
    "# boundary condition\n",
    "N=8\n",
    "x=0\n",
    "left_neighbour = (x-1) % N\n",
    "print(f\"Left neighbour of {x} is {left_neighbour}\")\n",
    "right_neighbour = (x+1) % N\n",
    "print(f\"Right neighbour of {x} is {right_neighbour}\")\n"
   ]
  }
